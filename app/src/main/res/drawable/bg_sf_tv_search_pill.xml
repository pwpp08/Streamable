<?xml version="1.0" encoding="utf-8"?>
<!-- TV search field. The container uses addStatesFromChildren, so it shows the primary ring while
     the text box or one of its buttons has D-pad focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="90"
    android:exitFadeDuration="90">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <solid android:color="?attr/colorSurfaceContainerHighest" />
            <stroke android:width="3dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="36dp" />
            <solid android:color="?attr/colorSurfaceContainerHigh" />
        </shape>
    </item>
</selector>
