<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="?attr/colorPrimary" />
            <stroke android:width="3dp" android:color="@color/favorite_selected" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/favorite_selected" />
            <stroke android:width="3dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="?attr/colorSurfaceContainerHighest" />
            <stroke android:width="1dp" android:color="?attr/colorOutline" />
        </shape>
    </item>

</selector>
