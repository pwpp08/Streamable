<?xml version="1.0" encoding="utf-8"?>
<!-- API 28 and older crash when a gradient mixes a theme colour with centerColor, so this
     fixed-colour copy is used there. drawable-v29 holds the themed original. -->
<!-- Phone details backdrop: status-bar protection on top, fade into the surface at the bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top|fill_horizontal" android:height="120dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="@android:color/transparent" android:startColor="#73000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/sf_crimson_dark_surface"
                android:centerY="0.72"
                android:endColor="@color/sf_crimson_dark_surface"
                android:startColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
