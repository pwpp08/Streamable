<?xml version="1.0" encoding="utf-8"?>
<!-- API 28 and older crash when a gradient mixes a theme colour with centerColor, so this
     fixed-colour copy is used there. drawable-v29 holds the themed original. -->
<!-- TV hero backdrop: fades into the surface on the left (behind the text) and at the bottom
     (into the rows). It is static, so it costs nothing while the rows scroll. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerX="0.4"
                android:startColor="@color/sf_crimson_dark_surface"
                android:centerColor="#B3000000"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerY="0.35"
                android:startColor="@color/sf_crimson_dark_surface"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
