<?xml version="1.0" encoding="utf-8"?>
<!-- Keys of value preferences equal the UserPreferences key names, so the stored type matches. -->
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Untitled category: only the gap between two groups of top-level rows. -->
    <PreferenceCategory
        android:key="group_media"
        android:layout="@layout/preference_sf_group_gap">

        <!-- 1. Languages -->
        <PreferenceScreen
            android:key="screen_languages"
            android:icon="@drawable/ic_sf_languages"
            android:title="@string/settings_section_languages"
            android:summary="@string/settings_section_languages_summary"
            android:widgetLayout="@layout/preference_widget_chevron"
            app:iconSpaceReserved="false">

            <PreferenceCategory
                android:title="@string/settings_section_languages"
                app:iconSpaceReserved="false">

                <Preference
                    android:key="spoken_languages"
                    android:title="@string/settings_spoken_languages_title"
                    android:persistent="false"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="primary_language"
                    android:title="@string/settings_primary_language_title"
                    android:persistent="false"
                    app:iconSpaceReserved="false" />

                <ListPreference
                    android:key="metadata_language"
                    android:title="@string/settings_metadata_language_title"
                    android:entries="@array/settings_metadata_language_entries"
                    android:entryValues="@array/settings_metadata_language_values"
                    android:persistent="false"
                    app:iconSpaceReserved="false" />

                <ListPreference
                    android:key="APP_LANGUAGE"
                    android:title="@string/settings_app_language_title"
                    android:defaultValue="system"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
        </PreferenceScreen>

        <!-- 2. Playback -->
        <PreferenceScreen
            android:key="screen_playback"
            android:icon="@drawable/ic_sf_playback"
            android:title="@string/settings_section_playback"
            android:summary="@string/settings_section_playback_summary"
            android:widgetLayout="@layout/preference_widget_chevron"
            app:iconSpaceReserved="false">

            <PreferenceCategory
                android:title="@string/settings_category_quality"
                app:iconSpaceReserved="false">

                <ListPreference
                    android:key="QUALITY_MODE"
                    android:title="@string/settings_quality_mode_title"
                    android:entries="@array/settings_quality_mode_entries"
                    android:entryValues="@array/settings_quality_mode_values"
                    android:defaultValue="MAX"
                    app:iconSpaceReserved="false" />

                <ListPreference
                    android:key="MAX_RESOLUTION"
                    android:title="@string/settings_max_resolution_title"
                    android:entries="@array/settings_max_resolution_entries"
                    android:entryValues="@array/settings_max_resolution_values"
                    android:defaultValue="0"
                    app:iconSpaceReserved="false" />

                <SwitchPreferenceCompat
                    android:key="DATA_SAVER_ON_MOBILE"
                    android:title="@string/settings_data_saver_title"
                    android:summary="@string/settings_data_saver_summary"
                    android:defaultValue="false"
                    app:iconSpaceReserved="false" />

                <ListPreference
                    android:key="BUFFER_PROFILE"
                    android:title="@string/settings_buffer_profile_title"
                    android:entries="@array/settings_buffer_profile_entries"
                    android:entryValues="@array/settings_buffer_profile_values"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>

            <PreferenceCategory
                android:title="@string/settings_category_next_episode"
                app:iconSpaceReserved="false">

                <SwitchPreferenceCompat
                    android:key="AUTOPLAY"
                    android:title="@string/settings_autoplay_next_title"
                    android:summaryOn="@string/settings_autoplay_on"
                    android:summaryOff="@string/settings_autoplay_off"
                    android:defaultValue="true"
                    app:iconSpaceReserved="false" />

                <ListPreference
                    android:key="UP_NEXT_SECONDS"
                    android:title="@string/settings_up_next_title"
                    android:entries="@array/settings_up_next_entries"
                    android:entryValues="@array/settings_up_next_values"
                    android:defaultValue="10"
                    android:dependency="AUTOPLAY"
                    app:iconSpaceReserved="false" />

                <EditTextPreference
                    android:key="p_settings_autoplay_buffer"
                    android:title="@string/settings_autoplay_buffer_title"
                    android:dialogMessage="@string/settings_autoplay_buffer_dialog_message"
                    android:defaultValue="3"
                    android:inputType="number"
                    android:dependency="AUTOPLAY"
                    app:iconSpaceReserved="false" />

                <ListPreference
                    android:key="SKIP_SEGMENTS_MODE"
                    android:title="@string/settings_skip_segments_title"
                    android:entries="@array/settings_skip_segments_entries"
                    android:entryValues="@array/settings_skip_segments_values"
                    android:defaultValue="BUTTON"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>

            <PreferenceCategory
                android:title="@string/settings_category_player"
                app:iconSpaceReserved="false">

                <SwitchPreferenceCompat
                    android:key="PLAYER_GESTURES"
                    android:title="@string/settings_player_gestures"
                    android:summaryOn="@string/settings_player_gestures_on"
                    android:summaryOff="@string/settings_player_gestures_off"
                    android:defaultValue="true"
                    app:iconSpaceReserved="false" />

                <SwitchPreferenceCompat
                    android:key="KEEP_SCREEN_ON_WHEN_PAUSED"
                    android:title="@string/settings_keep_screen_on_when_paused"
                    android:summary="@string/settings_keep_screen_on_when_paused_summary"
                    android:defaultValue="false"
                    app:iconSpaceReserved="false" />

                <SwitchPreferenceCompat
                    android:key="IMMERSIVE_MODE"
                    android:title="@string/settings_immersive_mode"
                    android:summaryOn="@string/settings_immersive_mode_on"
                    android:summaryOff="@string/settings_immersive_mode_off"
                    android:defaultValue="false"
                    app:iconSpaceReserved="false" />

                <ListPreference
                    android:key="preferred_player"
                    android:title="@string/settings_trailer_player_title"
                    android:summary="@string/settings_trailer_player_summary"
                    android:entries="@array/trailer_player_names"
                    android:entryValues="@array/trailer_player_values"
                    android:defaultValue="ask"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="preferred_player_reset"
                    android:title="@string/settings_trailer_player_reset"
                    android:summary="@string/settings_trailer_player_reset_summary"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
        </PreferenceScreen>

        <!-- 3. Subtitles -->
        <PreferenceScreen
            android:key="screen_subtitles"
            android:icon="@drawable/ic_sf_subtitles"
            android:title="@string/settings_section_subtitles"
            android:summary="@string/settings_section_subtitles_summary"
            android:widgetLayout="@layout/preference_widget_chevron"
            app:iconSpaceReserved="false">

            <PreferenceCategory
                android:title="@string/settings_section_subtitles"
                app:iconSpaceReserved="false">

                <ListPreference
                    android:key="SUBTITLE_MODE"
                    android:title="@string/settings_subtitle_mode_title"
                    android:entries="@array/settings_subtitle_mode_entries"
                    android:entryValues="@array/settings_subtitle_mode_values"
                    android:defaultValue="AUTO"
                    app:iconSpaceReserved="false" />

                <ListPreference
                    android:key="SUBTITLE_PRESET"
                    android:title="@string/settings_subtitle_preset_title"
                    android:entries="@array/settings_subtitle_preset_entries"
                    android:entryValues="@array/settings_subtitle_preset_values"
                    android:defaultValue="CLASSIC"
                    app:iconSpaceReserved="false" />

                <SwitchPreferenceCompat
                    android:key="SHOW_ALL_TRACK_LANGUAGES"
                    android:title="@string/settings_show_all_track_languages_title"
                    android:summary="@string/settings_show_all_track_languages_summary"
                    android:defaultValue="false"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="subtitle_fine_tune_info"
                    android:title="@string/settings_subtitle_fine_tune_title"
                    android:summary="@string/settings_subtitle_fine_tune_summary"
                    android:selectable="false"
                    android:persistent="false"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>

            <PreferenceCategory
                android:key="pc_subdl_settings"
                android:title="@string/settings_category_subdl"
                app:iconSpaceReserved="false">

                <EditTextPreference
                    android:key="SUBDL_API_KEY"
                    android:title="@string/settings_subdl_api_key"
                    android:summary="@string/settings_subdl_api_key_summary"
                    android:inputType="text"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
        </PreferenceScreen>
    </PreferenceCategory>

    <!-- Untitled category: only the gap between two groups of top-level rows. -->
    <PreferenceCategory
        android:key="group_sources"
        android:layout="@layout/preference_sf_group_gap">

        <!-- 4. Sources -->
        <PreferenceScreen
            android:key="screen_sources"
            android:icon="@drawable/ic_sf_sources"
            android:title="@string/settings_section_sources"
            android:summary="@string/settings_section_sources_summary"
            android:widgetLayout="@layout/preference_widget_chevron"
            app:iconSpaceReserved="false">

            <PreferenceCategory
                android:title="@string/settings_section_sources"
                app:iconSpaceReserved="false">

                <Preference
                    android:key="sources_providers"
                    android:title="@string/settings_sources_providers_title"
                    android:persistent="false"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="sources_health"
                    android:title="@string/settings_health_title"
                    android:summary="@string/settings_health_summary"
                    android:persistent="false"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>

            <PreferenceCategory
                android:key="pc_network_settings"
                android:title="@string/settings_category_network_title"
                app:iconSpaceReserved="false">

                <ListPreference
                    android:key="p_doh_provider_url"
                    android:title="@string/settings_doh_provider_title"
                    android:entries="@array/doh_provider_names"
                    android:entryValues="@array/doh_provider_urls"
                    android:defaultValue="https://cloudflare-dns.com/dns-query"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>

            <PreferenceCategory
                android:key="pc_tmdb_settings"
                android:title="@string/settings_category_tmdb"
                app:iconSpaceReserved="false">

                <SwitchPreferenceCompat
                    android:key="ENABLE_TMDB"
                    android:title="@string/settings_enable_tmdb_title"
                    android:summary="@string/settings_enable_tmdb_summary"
                    android:defaultValue="true"
                    app:iconSpaceReserved="false" />

                <MultiSelectListPreference
                    android:key="TMDB_CATEGORIES"
                    android:title="@string/settings_tmdb_categories_title"
                    android:summary="@string/settings_tmdb_categories_summary"
                    android:entries="@array/tmdb_home_categories_entries"
                    android:entryValues="@array/tmdb_home_categories_values"
                    android:defaultValue="@array/tmdb_home_categories_default"
                    app:iconSpaceReserved="false" />

                <EditTextPreference
                    android:key="TMDB_API_KEY"
                    android:title="@string/settings_tmdb_api_key"
                    android:summary="@string/settings_tmdb_api_key_summary"
                    android:inputType="text"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>

            <PreferenceCategory
                android:key="pc_streamingcommunity_settings"
                android:title="@string/settings_category_streamingcommunity"
                app:iconSpaceReserved="false">

                <EditTextPreference
                    android:key="provider_streamingcommunity_domain"
                    android:title="@string/settings_category_streamingcommunity_domain"
                    android:inputType="text"
                    android:persistent="false"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="provider_streamingcommunity_domain_reset"
                    android:title="@string/settings_streamingcommunity_domain_reset"
                    android:summary="@string/settings_streamingcommunity_domain_reset_summary"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
        </PreferenceScreen>

        <!-- 5. Sync & devices -->
        <PreferenceScreen
            android:key="screen_cloud_sync"
            android:icon="@drawable/ic_sf_devices"
            android:title="@string/settings_section_sync"
            android:summary="@string/cloud_sync_screen_summary"
            android:widgetLayout="@layout/preference_widget_chevron"
            app:iconSpaceReserved="false">

            <PreferenceCategory
                android:key="pc_devices"
                android:title="@string/settings_devices_category"
                app:iconSpaceReserved="false">
                <Preference
                    android:key="sync_pair_tv"
                    android:title="@string/settings_pair_tv_title"
                    android:summary="@string/settings_pair_tv_summary"
                    app:iconSpaceReserved="false" />
                <Preference
                    android:key="sync_remote"
                    android:title="@string/settings_remote_title"
                    android:summary="@string/settings_remote_summary"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>

            <PreferenceCategory
                android:key="pc_supabase_config"
                android:title="@string/supabase_config_category"
                app:iconSpaceReserved="false">
                <EditTextPreference
                    android:key="supabase_url"
                    android:title="@string/supabase_url_title"
                    android:summary="@string/supabase_url_summary"
                    android:inputType="textUri"
                    app:iconSpaceReserved="false" />
                <EditTextPreference
                    android:key="supabase_public_key"
                    android:title="@string/supabase_public_key_title"
                    android:summary="@string/supabase_public_key_summary"
                    android:inputType="text"
                    app:iconSpaceReserved="false" />
                <Preference
                    android:key="supabase_copy_sql"
                    android:title="@string/supabase_copy_sql_title"
                    android:summary="@string/supabase_copy_sql_summary"
                    app:iconSpaceReserved="false" />
                <Preference
                    android:key="supabase_open_sql"
                    android:title="@string/supabase_open_sql_title"
                    android:summary="@string/supabase_open_sql_summary"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>

            <PreferenceCategory
                android:key="pc_cloud_account"
                android:title="@string/cloud_sync_account_category"
                app:iconSpaceReserved="false">
                <Preference
                    android:key="supabase_instructions"
                    android:title="@string/supabase_instructions_title"
                    android:summary="@string/supabase_instructions_summary"
                    app:iconSpaceReserved="false" />
                <Preference
                    android:key="cloud_account_status"
                    android:title="@string/cloud_sync_account_status"
                    app:iconSpaceReserved="false" />
                <Preference
                    android:key="cloud_sign_in"
                    android:title="@string/cloud_sync_sign_in"
                    android:summary="@string/cloud_sync_sign_in_summary"
                    app:iconSpaceReserved="false" />
                <Preference
                    android:key="cloud_sign_up"
                    android:title="@string/cloud_sync_sign_up"
                    android:summary="@string/cloud_sync_sign_up_summary"
                    app:iconSpaceReserved="false" />
                <Preference
                    android:key="cloud_sign_out"
                    android:title="@string/cloud_sync_sign_out"
                    app:iconSpaceReserved="false" />
                <Preference
                    android:key="cloud_sync_now"
                    android:title="@string/cloud_sync_now"
                    android:summary="@string/cloud_sync_now_summary"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
        </PreferenceScreen>
    </PreferenceCategory>

    <!-- Untitled category: only the gap between two groups of top-level rows. -->
    <PreferenceCategory
        android:key="group_personal"
        android:layout="@layout/preference_sf_group_gap">

        <!-- 6. Home screen: row order and visibility (HomeScreenController) -->
        <Preference
            android:key="screen_home"
            android:icon="@drawable/ic_sf_home_rows"
            android:title="@string/settings_section_home"
            android:summary="@string/settings_home_summary"
            android:widgetLayout="@layout/preference_widget_chevron"
            android:persistent="false"
            app:iconSpaceReserved="false" />

        <!-- 7. Appearance -->
        <PreferenceScreen
            android:key="screen_appearance"
            android:icon="@drawable/ic_sf_appearance"
            android:title="@string/settings_category_appearance"
            android:summary="@string/settings_section_appearance_summary"
            android:widgetLayout="@layout/preference_widget_chevron"
            app:iconSpaceReserved="false">

            <PreferenceCategory
                android:title="@string/settings_category_appearance"
                app:iconSpaceReserved="false">

                <ListPreference
                    android:key="SELECTED_THEME"
                    android:title="@string/settings_theme_title"
                    android:entries="@array/theme_names"
                    android:entryValues="@array/theme_values"
                    android:defaultValue="default"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
        </PreferenceScreen>

        <!-- 8. Profiles & parental control -->
        <PreferenceScreen
            android:key="screen_profiles"
            android:icon="@drawable/ic_sf_profiles"
            android:title="@string/settings_section_profiles"
            android:summary="@string/settings_section_profiles_summary"
            android:widgetLayout="@layout/preference_widget_chevron"
            app:iconSpaceReserved="false">

            <PreferenceCategory
                android:title="@string/settings_screen_profiles_title"
                app:iconSpaceReserved="false">

                <Preference
                    android:key="key_profile_edit"
                    android:title="@string/profile_edit_btn"
                    android:summary="@string/settings_profile_edit_summary"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="key_profile_manage"
                    android:title="@string/profile_manage_btn"
                    android:summary="@string/settings_profile_manage_summary"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="key_profile_add"
                    android:title="@string/profile_add_btn"
                    android:summary="@string/settings_profile_add_summary"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>

            <PreferenceCategory
                android:key="pc_parental_control_settings"
                android:title="@string/settings_category_parental_control"
                app:iconSpaceReserved="false">

                <EditTextPreference
                    android:key="PARENTAL_CONTROL_PIN"
                    android:title="@string/settings_parental_pin_title"
                    android:summary="@string/settings_parental_pin_summary"
                    android:inputType="numberPassword"
                    android:persistent="false"
                    app:iconSpaceReserved="false" />

                <EditTextPreference
                    android:key="PARENTAL_CONTROL_ADMIN_PIN"
                    android:title="@string/settings_parental_admin_pin_title"
                    android:summary="@string/settings_parental_admin_pin_summary"
                    android:inputType="numberPassword"
                    android:persistent="false"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="PARENTAL_CONTROL_REMOVE_PIN"
                    android:title="@string/settings_parental_remove_pin_title"
                    android:summary="@string/settings_parental_remove_pin_summary"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="PARENTAL_CONTROL_REMOVE_ADMIN_PIN"
                    android:title="@string/settings_parental_remove_admin_pin_title"
                    android:summary="@string/settings_parental_remove_admin_pin_summary"
                    app:iconSpaceReserved="false" />

                <ListPreference
                    android:key="PARENTAL_CONTROL_MAX_AGE"
                    android:title="@string/settings_parental_max_age_title"
                    android:summary="@string/settings_parental_max_age_summary"
                    android:entries="@array/parental_control_age_entries"
                    android:entryValues="@array/parental_control_age_values"
                    android:defaultValue=""
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="PARENTAL_CONTROL_UNLOCK"
                    android:title="@string/settings_parental_unlock_title"
                    android:summary="@string/settings_parental_unlock_summary"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>

            <PreferenceCategory
                android:key="pc_recently_watched_settings"
                android:title="@string/settings_category_recently_watched"
                app:iconSpaceReserved="false">

                <SwitchPreferenceCompat
                    android:key="ENABLE_RECENTLY_WATCHED"
                    android:title="@string/settings_enable_recently_watched_title"
                    android:summary="@string/settings_enable_recently_watched_summary"
                    android:defaultValue="true"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="CLEAR_RECENTLY_WATCHED"
                    android:title="@string/settings_clear_recently_watched_title"
                    android:summary="@string/settings_clear_recently_watched_summary"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
        </PreferenceScreen>
    </PreferenceCategory>

    <!-- Untitled category: only the gap between two groups of top-level rows. -->
    <PreferenceCategory
        android:key="group_app"
        android:layout="@layout/preference_sf_group_gap">

        <!-- 9. Backup -->
        <PreferenceScreen
            android:key="screen_backup"
            android:icon="@drawable/ic_sf_backup"
            android:title="@string/settings_section_backup"
            android:summary="@string/settings_screen_backup_summary"
            android:widgetLayout="@layout/preference_widget_chevron"
            app:iconSpaceReserved="false">

            <PreferenceCategory
                android:title="@string/backup_category_title"
                app:iconSpaceReserved="false">

                <Preference
                    android:key="key_backup_export"
                    android:title="@string/backup_export_title"
                    android:summary="@string/backup_export_summary"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="key_backup_import"
                    android:title="@string/backup_import_title"
                    android:summary="@string/backup_import_summary"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="key_backup_refresh_cache"
                    android:title="@string/settings_refresh_cache_title"
                    android:summary="@string/settings_refresh_cache_summary"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="key_backup_export_db"
                    android:title="@string/backup_db_export_title"
                    android:summary="@string/backup_db_export_summary"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:key="key_backup_import_db"
                    android:title="@string/backup_db_import_title"
                    android:summary="@string/backup_db_import_summary"
                    app:iconSpaceReserved="false" />
            </PreferenceCategory>
        </PreferenceScreen>

        <!-- 10. About -->
        <PreferenceScreen
            android:key="screen_about"
            android:icon="@drawable/ic_sf_about"
            android:title="@string/settings_about"
            android:summary="@string/settings_section_about_summary"
            android:widgetLayout="@layout/preference_widget_chevron"
            app:iconSpaceReserved="false">

            <PreferenceCategory
                android:title="@string/settings_about"
                app:iconSpaceReserved="false">

                <Preference
                    android:icon="@drawable/ic_settings_about"
                    android:key="p_settings_about"
                    android:title="@string/settings_about" />

                <SwitchPreferenceCompat
                    android:key="UPDATE_CHECK_ENABLED"
                    android:title="@string/settings_update_check"
                    android:summary="@string/settings_update_check_summary"
                    android:defaultValue="true"
                    android:persistent="false"
                    app:iconSpaceReserved="false" />

                <Preference
                    android:icon="@drawable/ic_settings_help"
                    android:key="p_settings_help"
                    android:title="@string/settings_help" />

                <Preference
                    android:icon="@drawable/ic_telegram"
                    android:key="p_settings_telegram"
                    android:title="@string/settings_telegram" />
            </PreferenceCategory>
        </PreferenceScreen>
    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
