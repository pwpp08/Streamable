<?xml version="1.0" encoding="utf-8"?>
<!-- Phone poster tile for grids. The root is the click target (PressScale in
     MovieViewHolder); the card shows a tonal initial until the artwork arrives. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_movie_poster"
        style="@style/Widget.StreamFlix.Browse.PosterCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_movie_initial"
            style="@style/Widget.StreamFlix.Browse.PosterInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="T" />

        <ImageView
            android:id="@+id/iv_movie_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:duplicateParentState="true"
            android:foreground="?attr/selectableItemBackground"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/iv_movie_favorite_ribbon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:src="@drawable/ic_favorite_badge"
            android:visibility="gone"
            tools:ignore="ContentDescription"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/iv_movie_watched_ribbon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="6dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/ic_watched"
            android:visibility="gone"
            tools:ignore="ContentDescription"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_movie_rating"
            style="@style/Widget.StreamFlix.Browse.ArtworkChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:visibility="gone"
            tools:text="★ 7.8"
            tools:visibility="visible" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pb_movie_progress"
            style="@style/Widget.StreamFlix.Browse.PosterProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            tools:progress="60"
            tools:visibility="visible" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_movie_title"
        style="@style/Widget.StreamFlix.Browse.CardTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_movie_poster"
        tools:text="Title" />

    <TextView
        android:id="@+id/tv_movie_released_year"
        style="@style/Widget.StreamFlix.Browse.CardMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="@id/tv_movie_title"
        app:layout_constraintTop_toBottomOf="@id/tv_movie_title"
        tools:text="2022" />

    <TextView
        android:id="@+id/tv_movie_quality"
        style="@style/Widget.StreamFlix.Browse.CardMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAllCaps="true"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_movie_released_year"
        app:layout_constraintStart_toEndOf="@id/tv_movie_released_year"
        tools:text="HD" />

</androidx.constraintlayout.widget.ConstraintLayout>
