<?xml version="1.0" encoding="utf-8"?>
<!--
    TV search: a large pill field (ring while any part of it has focus), the "type on your phone"
    hint, focusable recent/suggestion rows, the global toggle and the results grid.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.search.SearchTvFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_search"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="100dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="100dp"
        android:addStatesFromChildren="true"
        android:background="@drawable/bg_sf_tv_search_pill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.leanback.widget.SearchEditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="16dp"
            android:drawableTint="?attr/colorOnSurfaceVariant"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:hint="@string/search_input_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:nextFocusRight="@+id/btn_search_clear"
            android:nextFocusDown="@id/ll_global_search"
            android:paddingStart="28dp"
            android:paddingEnd="8dp"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_search_clear"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btn_search_clear"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_sf_tv_icon_button"
            android:contentDescription="@string/ui_misc_search_clear"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@+id/et_search"
            android:nextFocusRight="@+id/btn_search_voice"
            android:nextFocusDown="@id/ll_global_search"
            android:padding="14dp"
            android:src="@drawable/ic_search_clear"
            android:tint="@color/sf_tv_icon_tint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_search_voice"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/btn_search_voice"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_sf_tv_icon_button"
            android:contentDescription="@string/ui_misc_search_voice"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@+id/btn_search_clear"
            android:nextFocusDown="@id/ll_global_search"
            android:padding="14dp"
            android:src="@drawable/ic_mic"
            android:tint="@color/sf_tv_icon_tint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="PrivateResource,UseAppTint" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Shown when this TV is signed in to sync, so the phone remote can type searches. -->
    <TextView
        android:id="@+id/tv_search_remote_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/ic_sf_smartphone"
        android:drawablePadding="10dp"
        android:drawableTint="?attr/colorOnSurfaceVariant"
        android:gravity="center_vertical"
        android:text="@string/ui_misc_search_type_on_phone"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/cl_search"
        app:layout_constraintStart_toStartOf="@id/cl_search"
        app:layout_constraintTop_toBottomOf="@id/cl_search"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sf_search_panel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@id/et_search"
        android:padding="10dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="@id/cl_search"
        app:layout_constraintHeight_max="300dp"
        app:layout_constraintStart_toStartOf="@id/cl_search"
        app:layout_constraintTop_toBottomOf="@id/tv_search_remote_hint" />

    <LinearLayout
        android:id="@+id/ll_global_search"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_sf_tv_chip"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/et_search"
        android:nextFocusDown="@id/vgv_search"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        app:layout_constraintStart_toStartOf="@id/cl_search"
        app:layout_constraintTop_toBottomOf="@id/rv_search_panel">

        <TextView
            android:id="@+id/tv_global_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:duplicateParentState="true"
            android:text="@string/global_search"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/iv_global_search_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:minHeight="0dp" />

    </LinearLayout>

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/vgv_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@id/et_search"
        android:padding="16dp"
        app:focusOutEnd="true"
        app:focusOutFront="true"
        app:focusOutSideEnd="true"
        app:focusOutSideStart="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_global_search"
        tools:listitem="@layout/item_movie_tv" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/vgv_search"
        app:layout_constraintEnd_toEndOf="@id/vgv_search"
        app:layout_constraintStart_toStartOf="@id/vgv_search"
        app:layout_constraintTop_toTopOf="@id/vgv_search" />

</androidx.constraintlayout.widget.ConstraintLayout>
