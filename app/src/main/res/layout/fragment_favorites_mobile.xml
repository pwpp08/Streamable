<?xml version="1.0" encoding="utf-8"?>
<!-- Favorites (phone): large app bar (sort and rearrange actions sit before the activity icons) over the sectioned grid. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.favorites.FavoritesMobileFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/abl_favorites"
        style="@style/Widget.StreamFlix.Browse.LargeAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/ctl_favorites"
            style="@style/Widget.StreamFlix.Browse.CollapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/browse_large_app_bar_height"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:title="@string/main_menu_favorites">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/tb_favorites"
                android:layout_width="match_parent"
                android:layout_height="@dimen/browse_top_bar_height"
                android:elevation="0dp"
                android:paddingEnd="@dimen/browse_top_actions_inset"
                app:layout_collapseMode="pin">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_favorites_reorder"
                    style="@style/Widget.StreamFlix.Browse.TopIconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:contentDescription="@string/favorites_reorder_categories"
                    app:icon="@drawable/ic_sort" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_favorites_reorder_mode"
                    style="@style/Widget.StreamFlix.Browse.TopIconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:checkable="false"
                    android:contentDescription="@string/favorites_rearrange_on"
                    app:icon="@drawable/ic_reorder_white" />
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_favorites"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/browse_gutter"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/browse_gutter"
        android:paddingBottom="@dimen/browse_row_gap"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_movie_grid_mobile" />

    <include
        android:id="@+id/tv_favorites_empty"
        layout="@layout/layout_browse_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
