<?xml version="1.0" encoding="utf-8"?>
<!--
    TV options: an expressive floating dialog (28dp, surfaceContainerHigh) with the artwork on
    the left and a grouped list of D-pad rows (focus = primary fill) on the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ud_options_dialog_tv"
    android:orientation="horizontal"
    android:padding="28dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_options_show_poster"
        android:layout_width="140dp"
        android:layout_height="210dp"
        android:background="?attr/colorSurfaceContainerHighest"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/ShapeAppearance.StreamFlix.Poster"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_options_show_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceHeadlineSmallEmphasized"
            android:textColor="?attr/colorOnSurface"
            tools:text="Title" />

        <TextView
            android:id="@+id/tv_show_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Subtitle" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_options_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btn_option_episode_open_tv_show"
                        style="@style/Widget.StreamFlix.Options.Row"
                        android:focusableInTouchMode="true"
                        android:text="@string/option_episode_open_tv_show" />

                    <TextView
                        android:id="@+id/btn_option_show_favorite"
                        style="@style/Widget.StreamFlix.Options.Row"
                        android:focusableInTouchMode="true"
                        android:text="@string/option_show_favorite" />

                    <TextView
                        android:id="@+id/btn_option_show_watched"
                        style="@style/Widget.StreamFlix.Options.Row"
                        android:focusableInTouchMode="true"
                        android:text="@string/option_show_watched" />

                    <TextView
                        android:id="@+id/btn_option_episode_mark_all_previous_watched"
                        style="@style/Widget.StreamFlix.Options.Row"
                        android:focusableInTouchMode="true"
                        android:text="@string/option_show_mark_all_previous_watched" />

                    <TextView
                        android:id="@+id/btn_option_episode_mark_season_watched"
                        style="@style/Widget.StreamFlix.Options.Row"
                        android:focusableInTouchMode="true"
                        android:text="@string/option_mark_season_watched"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btn_option_program_clear"
                        style="@style/Widget.StreamFlix.Options.Row"
                        android:focusableInTouchMode="true"
                        android:text="@string/option_clear_program" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_option_cancel"
                    style="@style/Widget.StreamFlix.Options.Row"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/ud_list_row_single"
                    android:focusableInTouchMode="true"
                    android:text="@string/option_cancel" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</LinearLayout>
