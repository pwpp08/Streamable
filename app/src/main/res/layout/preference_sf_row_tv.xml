<?xml version="1.0" encoding="utf-8"?>
<!--
    TV settings row (Leanback). The background with the focus ring and the focus spring scale are
    set by SettingsGroupDecoration. Sizes are for reading from across the room.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:id="@id/icon_frame"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_sf_pref_icon"
        android:duplicateParentState="true">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:tint="?attr/colorOnSecondaryContainer" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.StreamFlix.Settings.TvTitle"
            android:textColor="@color/sf_text_on_surface" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="@style/TextAppearance.StreamFlix.Settings.TvSummary"
            android:textColor="@color/sf_text_on_surface_variant" />
    </LinearLayout>

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:duplicateParentState="true"
        android:gravity="center_vertical|end"
        android:minWidth="24dp"
        android:orientation="vertical"
        android:paddingStart="16dp" />
</LinearLayout>
