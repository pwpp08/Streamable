<?xml version="1.0" encoding="utf-8"?>
<!-- Spinner (full screen): the title under the pointer up top (backdrop, title, overview,
     Play / Details), the poster wheel rising from the bottom edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_queue_spin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_background_color"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/tg_queue_spin_filter"
            style="@style/Widget.StreamFlix.ToggleGroup.Connected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_queue_spin_all"
                style="@style/Widget.StreamFlix.Queue.SectionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/queue_filter_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_queue_spin_movies"
                style="@style/Widget.StreamFlix.Queue.SectionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/queue_filter_movies" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_queue_spin_shows"
                style="@style/Widget.StreamFlix.Queue.SectionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/queue_filter_shows" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_queue_spin_close"
            style="@style/Widget.Material3Expressive.Button.IconButton.Standard"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/queue_close"
            app:icon="@drawable/ic_queue_close" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_queue_spin_hero"
        style="@style/Widget.StreamFlix.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:layout_weight="0.62"
        app:cardCornerRadius="24dp">

        <TextView
            android:id="@+id/tv_queue_spin_initial"
            style="@style/Widget.StreamFlix.Browse.PosterInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/iv_queue_spin_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_queue_spin_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceHeadlineSmallEmphasized"
        android:textColor="?attr/colorOnSurface"
        tools:text="The Flash" />

    <TextView
        android:id="@+id/tv_queue_spin_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorPrimary"
        tools:text="Movie · 2023 · ★ 6.5" />

    <TextView
        android:id="@+id/tv_queue_spin_overview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="When his attempt to save his family inadvertently alters the future, Barry Allen becomes trapped in a reality…" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_queue_spin_play"
            style="@style/Widget.StreamFlix.Button"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/queue_action_play"
            app:icon="@drawable/ic_sf_play" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_queue_spin_details"
            style="@style/Widget.StreamFlix.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:text="@string/queue_action_details" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_queue_spin"
            style="@style/Widget.StreamFlix.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/queue_spin_button"
            app:icon="@drawable/ic_queue_spin" />
    </LinearLayout>

    <com.streamflixreborn.streamflix.fragments.queue.PosterWheelView
        android:id="@+id/wheel_queue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:contentDescription="@string/queue_spin_hint"
        android:minHeight="220dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text="@string/queue_spin_hint"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
