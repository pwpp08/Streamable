<?xml version="1.0" encoding="utf-8"?>
<!--
    Phone episode row: 16:9 thumbnail (16dp) with a watched check, "E5 · Title", date / time left,
    a wavy progress bar when partly watched, the download control and the synopsis.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_episode_poster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceContainerHigh"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.42"
        app:shapeAppearance="@style/ShapeAppearance.StreamFlix.Poster"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/iv_episode_watched_ribbon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="6dp"
        android:background="@drawable/ud_watched_badge"
        android:contentDescription="@string/episode_watched"
        android:padding="4dp"
        android:src="@drawable/ic_ud_check"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/iv_episode_poster"
        app:layout_constraintTop_toTopOf="@id/iv_episode_poster"
        app:tint="?attr/colorOnPrimary"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_episode_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceTitleSmallEmphasized"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toStartOf="@id/btn_episode_download"
        app:layout_constraintStart_toEndOf="@id/iv_episode_poster"
        app:layout_constraintTop_toTopOf="@id/iv_episode_poster"
        tools:text="E5 · Title" />

    <TextView
        android:id="@+id/tv_episode_released"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/btn_episode_download"
        app:layout_constraintStart_toEndOf="@id/iv_episode_poster"
        app:layout_constraintTop_toBottomOf="@id/tv_episode_title"
        tools:text="2024-05-01 · 12 min left" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pb_episode_progress"
        style="@style/Widget.StreamFlix.Details.Progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:max="100"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_episode_poster"
        app:layout_constraintTop_toBottomOf="@id/tv_episode_released"
        tools:progress="40"
        tools:visibility="visible" />

    <com.streamflixreborn.streamflix.downloads.DownloadButton
        android:id="@+id/btn_episode_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="40dp"
        android:minHeight="40dp"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_episode_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iv_episode_poster,pb_episode_progress,tv_episode_released" />

    <TextView
        android:id="@+id/tv_episode_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier_episode_head"
        tools:text="Overview" />

</androidx.constraintlayout.widget.ConstraintLayout>
