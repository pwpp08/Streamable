<?xml version="1.0" encoding="utf-8"?>
<!-- Swipe: a two-card stack (the next title peeks behind) with Skip / Seen it / Add. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/queue_swipe_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmallEmphasized"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tv_queue_swipe_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/queue_swipe_hint"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <FrameLayout
        android:id="@+id/fl_queue_swipe_stack"
        android:layout_width="280dp"
        android:layout_height="420dp"
        android:layout_marginTop="16dp"
        android:clipChildren="false">

        <include
            android:id="@+id/card_queue_swipe_back"
            layout="@layout/item_queue_swipe_card" />

        <include
            android:id="@+id/card_queue_swipe_front"
            layout="@layout/item_queue_swipe_card" />

        <LinearLayout
            android:id="@+id/ll_queue_swipe_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.loadingindicator.LoadingIndicator
                style="@style/Widget.StreamFlix.LoadingIndicator.Contained"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/queue_swipe_loading"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_queue_swipe_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/queue_swipe_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButtonGroup
        android:id="@+id/bg_queue_swipe_actions"
        style="@style/Widget.Material3Expressive.MaterialButtonGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_queue_swipe_skip"
            style="@style/Widget.StreamFlix.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/queue_swipe_skip"
            app:icon="@drawable/ic_queue_close"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_queue_swipe_seen"
            style="@style/Widget.StreamFlix.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/queue_swipe_seen"
            app:icon="@drawable/ic_watched"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_queue_swipe_add"
            style="@style/Widget.StreamFlix.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/queue_swipe_add"
            app:icon="@drawable/ic_queue_add"
            app:iconGravity="textStart" />
    </com.google.android.material.button.MaterialButtonGroup>

    <TextView
        android:id="@+id/tv_queue_swipe_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorPrimary"
        android:visibility="invisible"
        tools:text="3 added to your Queue"
        tools:visibility="visible" />

</LinearLayout>
