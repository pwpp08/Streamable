<?xml version="1.0" encoding="utf-8"?>
<!-- Details "Director" line: label and names on one baseline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:orientation="horizontal"
    android:paddingStart="64dp"
    android:paddingEnd="64dp">

    <TextView
        android:id="@+id/tv_tv_show_directors_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_show_directors"
        android:textAppearance="?attr/textAppearanceTitleMediumEmphasized"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/hgv_tv_show_directors"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Director" />

</LinearLayout>
