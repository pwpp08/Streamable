<?xml version="1.0" encoding="utf-8"?>
<!-- Episode row of the show view: still, "E3 · Title", air date, and the watched tick. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.StreamFlix.Browse.PosterCard"
        android:layout_width="96dp"
        android:layout_height="54dp">

        <ImageView
            android:id="@+id/iv_episode_still"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_episode_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="E3 · Sundae Best" />

        <TextView
            android:id="@+id/tv_episode_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Aired Jun 22" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_episode_watched"
        style="@style/Widget.StreamFlix.Button.Icon.Tonal"
        android:layout_width="44dp"
        android:layout_height="34dp"
        android:checkable="true"
        android:contentDescription="@string/queue_action_mark_watched"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:cornerRadius="10dp"
        app:icon="@drawable/ic_ud_check"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="20dp" />
</LinearLayout>
