<?xml version="1.0" encoding="utf-8"?>
<!-- TV featured row: the CTA under the home hero. The hero itself (backdrop, title, synopsis)
     is in fragment_home_tv and follows focus; D-pad right on the button cycles featured items. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tv_category_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btn_swiper_watch_now"
        style="@style/AppTheme.Widget.Tv.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/browse_tv_gutter"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="@string/home_swiper_watch_now"
        android:textAppearance="?attr/textAppearanceLabelLargeEmphasized"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/ll_dots_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/btn_swiper_watch_now"
        app:layout_constraintStart_toEndOf="@id/btn_swiper_watch_now"
        app:layout_constraintTop_toTopOf="@id/btn_swiper_watch_now" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pb_swiper_progress"
        style="@style/Widget.StreamFlix.Browse.PosterProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/btn_swiper_watch_now"
        app:layout_constraintStart_toStartOf="@id/btn_swiper_watch_now"
        app:layout_constraintTop_toBottomOf="@id/btn_swiper_watch_now"
        tools:progress="40"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
