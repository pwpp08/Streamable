<?xml version="1.0" encoding="utf-8"?>
<!--
    TV player controls (Media3 custom controller), all D-pad reachable:
      centre row   prev · −10 s · PLAY/PAUSE (default focus) · +10 s · next
      time bar     (D-pad left/right scrubs 10 s)
      toolbar      restart · subtitles · audio · quality · speed · servers · aspect · settings
    Focus: primary disc behind icons, primary ring on the seek glyphs, the play button fills
    primary and springs. Back hides the controls first (PlayerTvFragment.onBackPressed).
    Only alpha/translation/scale animate, to keep the weak projector at full frame rate.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_exo_controller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/ud_player_scrim"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone" />

    <!-- ============================================================ top -->
    <TextView
        android:id="@+id/tv_exo_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceHeadlineMediumEmphasized"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toStartOf="@id/btn_exo_external_player"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Title" />

    <TextView
        android:id="@+id/tv_exo_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toStartOf="@id/btn_exo_external_player"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_exo_title"
        tools:text="S1 E2  •  Description" />

    <ImageView
        android:id="@+id/btn_exo_external_player"
        style="@style/Widget.StreamFlix.Player.IconButton.Tv"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="48dp"
        android:contentDescription="@string/player_external_player"
        android:nextFocusLeft="@id/btn_exo_external_player"
        android:nextFocusRight="@id/btn_exo_external_player"
        android:nextFocusDown="@id/exo_play_pause"
        android:src="@drawable/exo_styled_controls_external_player"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================================================ centre -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_custom_prev"
            style="@style/Widget.StreamFlix.Player.IconButton.Tv"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="12dp"
            android:padding="16dp"
            android:contentDescription="@string/player_previous_episode"
            android:nextFocusLeft="@id/btn_custom_prev"
            android:nextFocusRight="@id/exo_rew_with_amount"
            android:nextFocusUp="@id/btn_exo_external_player"
            android:nextFocusDown="@id/exo_progress"
            android:src="@drawable/ic_ud_skip_previous" />

        <TextView
            android:id="@id/exo_rew_with_amount"
            style="@style/Widget.StreamFlix.Player.SeekButton.Tv"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/player_rewind"
            android:nextFocusLeft="@id/btn_custom_prev"
            android:nextFocusRight="@id/exo_play_pause"
            android:nextFocusUp="@id/btn_exo_external_player"
            android:nextFocusDown="@id/exo_progress"
            android:textSize="13sp"
            tools:text="10" />

        <com.streamflixreborn.streamflix.ui.player.PlayPauseMorphButton
            android:id="@id/exo_play_pause"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:contentDescription="@string/player_play_pause"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/exo_rew_with_amount"
            android:nextFocusRight="@id/exo_ffwd_with_amount"
            android:nextFocusUp="@id/btn_exo_external_player"
            android:nextFocusDown="@id/exo_settings"
            android:padding="26dp"
            android:scaleType="fitCenter"
            android:src="@drawable/exo_styled_controls_play"
            app:morphAnimated="false"
            app:morphFillColor="@color/ud_tv_hero_bg"
            app:tint="@color/ud_tv_hero_fg" />

        <TextView
            android:id="@id/exo_ffwd_with_amount"
            style="@style/Widget.StreamFlix.Player.SeekButton.Tv.Forward"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/player_fast_forward"
            android:nextFocusLeft="@id/exo_play_pause"
            android:nextFocusRight="@id/btn_custom_next"
            android:nextFocusUp="@id/btn_exo_external_player"
            android:nextFocusDown="@id/exo_progress"
            android:textSize="13sp"
            tools:text="10" />

        <ImageView
            android:id="@+id/btn_custom_next"
            style="@style/Widget.StreamFlix.Player.IconButton.Tv"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="12dp"
            android:padding="16dp"
            android:contentDescription="@string/player_next_episode"
            android:nextFocusLeft="@id/exo_ffwd_with_amount"
            android:nextFocusRight="@id/btn_custom_next"
            android:nextFocusUp="@id/btn_exo_external_player"
            android:nextFocusDown="@id/exo_progress"
            android:src="@drawable/ic_ud_skip_next" />

    </LinearLayout>

    <!-- ============================================================ bottom -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_skip_intro"
        style="@style/Widget.StreamFlix.Player.SkipPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="16dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="@string/player_skip_intro"
        android:visibility="gone"
        app:icon="@drawable/exo_styled_controls_fastforward"
        app:layout_constraintBottom_toTopOf="@id/exo_progress"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/exo_settings"
        app:bar_height="8dp"
        app:layout_constraintBottom_toTopOf="@id/exo_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:scrubber_disabled_size="0dp"
        app:scrubber_dragged_size="30dp"
        app:scrubber_enabled_size="20dp"
        app:touch_target_height="44dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="28dp"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMediumEmphasized"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="00:00:00" />

        <TextView
            android:id="@+id/tv_time_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="/"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/exo_position"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_time_separator"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="00:00:00" />

        <!-- Floating toolbar of actions. -->
        <LinearLayout
            android:id="@+id/ll_exo_toolbar"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:background="@drawable/ud_player_toolbar"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/exo_replay"
                style="@style/Widget.StreamFlix.Player.IconButton.Tv"
                android:contentDescription="@string/player_restart"
                android:nextFocusLeft="@id/exo_replay"
                android:nextFocusUp="@id/exo_progress"
                android:src="@drawable/ic_ud_restart" />

            <ImageView
                android:id="@+id/btn_exo_subtitles"
                style="@style/Widget.StreamFlix.Player.IconButton.Tv"
                android:contentDescription="@string/player_settings_subtitles_title"
                android:nextFocusUp="@id/exo_progress"
                android:src="@drawable/ic_ud_subtitles" />

            <ImageView
                android:id="@+id/btn_exo_audio"
                style="@style/Widget.StreamFlix.Player.IconButton.Tv"
                android:contentDescription="@string/player_settings_audio_title"
                android:nextFocusUp="@id/exo_progress"
                android:src="@drawable/ic_player_settings_audio" />

            <ImageView
                android:id="@+id/btn_exo_quality"
                style="@style/Widget.StreamFlix.Player.IconButton.Tv"
                android:contentDescription="@string/player_settings_quality_title"
                android:nextFocusUp="@id/exo_progress"
                android:src="@drawable/ic_player_settings_quality" />

            <ImageView
                android:id="@+id/btn_exo_speed"
                style="@style/Widget.StreamFlix.Player.IconButton.Tv"
                android:contentDescription="@string/player_settings_speed_title"
                android:nextFocusUp="@id/exo_progress"
                android:src="@drawable/ic_player_settings_playback_speed" />

            <ImageView
                android:id="@+id/btn_exo_servers"
                style="@style/Widget.StreamFlix.Player.IconButton.Tv"
                android:contentDescription="@string/player_settings_servers_title"
                android:nextFocusUp="@id/exo_progress"
                android:src="@drawable/ic_player_settings_servers" />

            <ImageView
                android:id="@+id/btn_exo_aspect_ratio"
                style="@style/Widget.StreamFlix.Player.IconButton.Tv"
                android:contentDescription="@string/player_aspect_ratio"
                android:nextFocusUp="@id/exo_progress"
                android:src="@drawable/exo_styled_controls_aspect_ratio" />

            <ImageView
                android:id="@id/exo_settings"
                style="@style/Widget.StreamFlix.Player.IconButton.Tv"
                android:contentDescription="@string/player_settings"
                android:nextFocusRight="@id/exo_settings"
                android:nextFocusUp="@id/exo_progress"
                android:src="@drawable/exo_styled_controls_settings" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
