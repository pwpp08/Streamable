<?xml version="1.0" encoding="utf-8"?>
<!-- Queue (phone): three tabs with counts on top, a dense edge-to-edge poster grid, and Spin / Swipe
     plus the filter row floating over the bottom of the grid. Sorting, Coming up and Import live
     behind the tune button. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.queue.QueueMobileFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/abl_queue"
        style="@style/Widget.StreamFlix.Browse.LargeAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs_queue"
            style="@style/Widget.Material3.TabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabGravity="fill"
            app:tabIndicatorFullWidth="true"
            app:tabMode="fixed"
            app:tabTextAppearance="?attr/textAppearanceLabelMedium" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_queue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="132dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_queue_card_mobile" />

    <include
        android:id="@+id/queue_empty"
        layout="@layout/layout_browse_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Floating over the grid; the scrim behind it is drawn in code from the surface colour. -->
    <LinearLayout
        android:id="@+id/ll_queue_floating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/ll_queue_pills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_queue_spin"
                style="@style/Widget.StreamFlix.Queue.FloatPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="@string/queue_spin"
                app:icon="@drawable/ic_queue_spin" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_queue_swipe"
                style="@style/Widget.StreamFlix.Queue.FloatPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/queue_swipe"
                app:icon="@drawable/ic_queue_swipe" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/hsv_queue_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_queue_tune"
                    style="@style/Widget.StreamFlix.Queue.FloatIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/queue_tune"
                    app:icon="@drawable/ic_queue_tune" />

                <!-- In progress and Watchlist: which kind of title. -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_queue_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_queue_all"
                        style="@style/Widget.StreamFlix.Queue.FloatChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/queue_filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_queue_movies"
                        style="@style/Widget.StreamFlix.Queue.FloatChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/queue_filter_movies" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_queue_shows"
                        style="@style/Widget.StreamFlix.Queue.FloatChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/queue_filter_shows" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Watched: All, then one chip per rating (built in code). -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_queue_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true"
                    tools:visibility="visible" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
