<?xml version="1.0" encoding="utf-8"?>
<!-- Queue (phone), compact: one header row (title + Spin / Swipe / Coming up / Import / Sort), the
     section switch, one scrolling row of filters (kind, and the ratings in Watched), then the list. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.queue.QueueMobileFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/abl_queue"
        style="@style/Widget.StreamFlix.Browse.LargeAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/ll_queue_header"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/browse_gutter"
            android:paddingEnd="4dp"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <TextView
                android:id="@+id/tv_queue_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/queue_title"
                android:textAppearance="?attr/textAppearanceTitleLargeEmphasized"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_queue_spin"
                style="@style/Widget.StreamFlix.Queue.HeaderIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/queue_spin"
                app:icon="@drawable/ic_queue_spin" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_queue_swipe"
                style="@style/Widget.StreamFlix.Queue.HeaderIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/queue_swipe"
                app:icon="@drawable/ic_queue_swipe" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_queue_calendar"
                style="@style/Widget.StreamFlix.Queue.HeaderIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/queue_calendar"
                app:icon="@drawable/ic_queue_calendar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_queue_import"
                style="@style/Widget.StreamFlix.Queue.HeaderIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/queue_import"
                app:icon="@drawable/ic_queue_import" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_queue_sort"
                style="@style/Widget.StreamFlix.Queue.HeaderIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/queue_sort"
                app:icon="@drawable/ic_sort" />
        </LinearLayout>

        <!-- Not scrolling: stays pinned under the header. -->
        <LinearLayout
            android:id="@+id/ll_queue_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tg_queue_section"
                style="@style/Widget.StreamFlix.ToggleGroup.Connected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/browse_gutter"
                android:layout_marginEnd="@dimen/browse_gutter"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_queue_up_next"
                    style="@style/Widget.StreamFlix.Queue.SectionButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/queue_section_up_next" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_queue_watchlist"
                    style="@style/Widget.StreamFlix.Queue.SectionButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/queue_section_watchlist" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_queue_watched"
                    style="@style/Widget.StreamFlix.Queue.SectionButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/queue_section_watched" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <HorizontalScrollView
                android:id="@+id/hsv_queue_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/browse_gutter"
                android:paddingEnd="@dimen/browse_gutter"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cg_queue_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_queue_all"
                            style="@style/Widget.StreamFlix.Queue.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/queue_filter_all" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_queue_movies"
                            style="@style/Widget.StreamFlix.Queue.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/queue_filter_movies" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_queue_shows"
                            style="@style/Widget.StreamFlix.Queue.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/queue_filter_shows" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Watched only: filter by how you rated it. Tap again to clear. -->
                    <LinearLayout
                        android:id="@+id/ll_queue_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="1dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:background="?attr/colorOutlineVariant" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cg_queue_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="6dp"
                            app:singleLine="true"
                            app:singleSelection="true" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_queue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/browse_gutter"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/browse_gutter"
        android:paddingBottom="@dimen/browse_row_gap"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_queue_card_mobile" />

    <include
        android:id="@+id/queue_empty"
        layout="@layout/layout_browse_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
