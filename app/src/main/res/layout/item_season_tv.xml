<?xml version="1.0" encoding="utf-8"?>
<!-- TV season card: focusable poster (16dp, primary focus ring + spring scale) and its title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="180dp"
        android:duplicateParentState="true">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_season_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceContainerHigh"
            android:duplicateParentState="true"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.StreamFlix.Poster"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/iv_season_watched_ribbon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/ud_watched_badge"
            android:contentDescription="@string/episode_watched"
            android:padding="4dp"
            android:src="@drawable/ic_ud_check"
            android:visibility="gone"
            app:tint="?attr/colorOnPrimary"
            tools:visibility="visible" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fg_item_season_image_tv"
            android:duplicateParentState="true" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_season_title"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleSmallEmphasized"
        android:textColor="?attr/colorOnSurface"
        tools:text="Season #" />

</LinearLayout>
