<?xml version="1.0" encoding="utf-8"?>
<!-- "How was it?" after a movie is marked watched: five ratings in one row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reaction_1"
        style="@style/Widget.StreamFlix.Queue.RatingChoice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reaction_2"
        style="@style/Widget.StreamFlix.Queue.RatingChoice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reaction_3"
        style="@style/Widget.StreamFlix.Queue.RatingChoice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reaction_4"
        style="@style/Widget.StreamFlix.Queue.RatingChoice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reaction_5"
        style="@style/Widget.StreamFlix.Queue.RatingChoice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />
</LinearLayout>
