<?xml version="1.0" encoding="utf-8"?>
<!--
    Phone player settings: a modal side sheet (28dp leading corners, surfaceContainerLow) beside
    the video, because the phone player is landscape-only and a bottom sheet would show only a
    few rows. Rows are a grouped expressive list (item_setting_mobile).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ud_player_panel_mobile"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/btn_settings_back"
        style="@style/Widget.StreamFlix.Player.IconButton"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/player_back"
        android:src="@drawable/ic_ud_arrow_back"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_settings_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleLargeEmphasized"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintBottom_toBottomOf="@id/btn_settings_close"
        app:layout_constraintEnd_toStartOf="@id/btn_settings_close"
        app:layout_constraintStart_toEndOf="@id/btn_settings_back"
        app:layout_constraintTop_toTopOf="@id/btn_settings_close"
        app:layout_goneMarginStart="24dp"
        tools:text="Settings" />

    <ImageView
        android:id="@+id/btn_settings_close"
        style="@style/Widget.StreamFlix.Player.IconButton"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/option_cancel"
        android:src="@drawable/ic_player_settings_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_settings_header,btn_settings_close" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_settings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier1"
        tools:listitem="@layout/item_setting_mobile" />

</androidx.constraintlayout.widget.ConstraintLayout>
