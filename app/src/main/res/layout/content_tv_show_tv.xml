<?xml version="1.0" encoding="utf-8"?>
<!--
    TV-show header: a left-aligned text column over the fragment's full-screen backdrop, with a
    row of D-pad buttons (focus = primary fill + spring scale, see MovieViewHolder).
    Mirrors content_tv_show_tv (a whole show has no "watched" toggle).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="64dp"
    android:paddingTop="96dp"
    android:paddingBottom="8dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_tv_show_column_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6" />

    <TextView
        android:id="@+id/tv_tv_show_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceDisplaySmallEmphasized"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="@id/gl_tv_show_column_end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Title" />

    <LinearLayout
        android:id="@+id/ll_tv_show_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:divider="@drawable/ud_meta_dot"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:showDividers="middle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_title">

        <TextView
            android:id="@+id/tv_tv_show_released"
            style="@style/Widget.StreamFlix.Details.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            tools:text="yyyy" />

        <TextView
            android:id="@+id/tv_tv_show_runtime"
            style="@style/Widget.StreamFlix.Details.Meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            tools:text="# h # min" />

        <LinearLayout
            android:id="@+id/ll_tv_show_rating"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/ud_rating_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/iv_tv_show_rating_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_star"
                android:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tv_tv_show_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textAppearance="?attr/textAppearanceTitleSmallEmphasized"
                android:textColor="?attr/colorOnSurface"
                tools:text="#.#" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_tv_show_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ud_quality_pill"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textAllCaps="true"
            android:textAppearance="?attr/textAppearanceLabelLargeEmphasized"
            android:textColor="?attr/colorOnSurface"
            tools:text="HD" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tv_show_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="@id/gl_tv_show_column_end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_meta"
        tools:text="Genres" />

    <TextView
        android:id="@+id/tv_tv_show_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="4"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="@id/gl_tv_show_column_end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_genres"
        tools:text="Overview" />

    <LinearLayout
        android:id="@+id/ll_tv_show_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tv_show_watch_now"
            style="@style/Widget.StreamFlix.Details.Tv.Button.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:nextFocusLeft="@id/btn_tv_show_watch_now"
            android:text="@string/details_play"
            app:icon="@drawable/ic_ud_play" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tv_show_trailer"
            style="@style/Widget.StreamFlix.Details.Tv.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/tv_show_trailer"
            app:icon="@drawable/ic_ud_trailer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tv_show_favorite"
            style="@style/Widget.StreamFlix.Details.Tv.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:checkable="true"
            android:contentDescription="@string/details_action_favorite"
            android:nextFocusRight="@id/btn_tv_show_favorite"
            app:icon="@drawable/ic_ud_favorite_toggle" />

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pb_tv_show_progress_episode"
        style="@style/Widget.StreamFlix.Details.Progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:max="100"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/ll_tv_show_actions"
        app:layout_constraintStart_toStartOf="@id/ll_tv_show_actions"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_actions"
        tools:progress="60"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
