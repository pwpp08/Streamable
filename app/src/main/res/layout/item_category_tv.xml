<?xml version="1.0" encoding="utf-8"?>
<!-- Home row (TV): emphasized title, then a Leanback row. Unclipped so the focused card can
     scale past the row bounds. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/tv_category_title"
        style="@style/Widget.StreamFlix.Browse.RowHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/browse_tv_gutter"
        android:layout_marginEnd="@dimen/browse_tv_gutter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Title" />

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/hgv_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/browse_tv_gutter"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/browse_tv_gutter"
        android:paddingBottom="8dp"
        app:focusOutEnd="true"
        app:focusOutFront="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_category_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
