<?xml version="1.0" encoding="utf-8"?>
<!--
    Non-blocking player overlays: the Skip intro / recap extended pill (secondaryContainer;
    tap to skip) and the short "switched server" message pill.
    Both only fade (OverlayUi), so they cost nothing over video.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_skip_segment"
        style="@style/Widget.StreamFlix.Player.SkipPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="84dp"
        android:focusable="false"
        android:visibility="gone"
        app:icon="@drawable/exo_styled_controls_fastforward"
        tools:text="Skip intro"
        tools:visibility="visible" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_player_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="20dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
        app:cardElevation="0dp"
        app:shapeAppearance="@style/ShapeAppearance.StreamFlix.Pill"
        app:strokeWidth="0dp"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_player_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:textAppearance="?attr/textAppearanceLabelLargeEmphasized"
            android:textColor="?attr/colorOnSurface"
            tools:text="Switched to VixSrc" />
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
