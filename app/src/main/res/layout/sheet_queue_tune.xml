<?xml version="1.0" encoding="utf-8"?>
<!-- "Tune" sheet of the Queue: how the list is ordered, which kind of title shows (Watched), and the
     rarely used tools (Coming up, Import). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tv_queue_tune_sort_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/queue_sort"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cg_queue_tune_sort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleSelection="true" />

    <TextView
        android:id="@+id/tv_queue_tune_kind_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/queue_tune_show"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cg_queue_tune_kind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_queue_tune_all"
            style="@style/Widget.StreamFlix.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/queue_filter_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_queue_tune_movies"
            style="@style/Widget.StreamFlix.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/queue_filter_movies" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_queue_tune_shows"
            style="@style/Widget.StreamFlix.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/queue_filter_shows" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_queue_tune_calendar"
        style="@style/Widget.StreamFlix.Queue.SheetAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/queue_calendar_title"
        app:icon="@drawable/ic_queue_calendar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_queue_tune_import"
        style="@style/Widget.StreamFlix.Queue.SheetAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/queue_import"
        app:icon="@drawable/ic_queue_import" />
</LinearLayout>
