<?xml version="1.0" encoding="utf-8"?>
<!-- TV rail header: provider logo and profile avatar, centred on the collapsed rail's icon
     column; their names appear when the rail expands. -->
<com.tanasi.navigation.widget.NavigationSlideHeaderView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/iv_navigation_header_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:foreground="@drawable/fg_browse_rail_header_focus"
        android:nextFocusDown="@id/fl_header_profile_avatar"
        android:padding="3dp"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription,UseAppTint" />

    <TextView
        android:id="@+id/tv_navigation_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleSmallEmphasized"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_navigation_header_icon"
        app:layout_constraintTop_toTopOf="@id/iv_navigation_header_icon"
        tools:text="Title" />

    <TextView
        android:id="@+id/tv_navigation_header_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_navigation_header_icon"
        app:layout_constraintTop_toBottomOf="@id/tv_navigation_header_title"
        tools:text="Subtitle" />

    <View
        android:id="@+id/view_provider_profile_divider"
        android:layout_width="32dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="?attr/colorOutlineVariant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_navigation_header_icon" />

    <FrameLayout
        android:id="@+id/fl_header_profile_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:foreground="@drawable/fg_browse_rail_header_focus"
        android:nextFocusUp="@id/iv_navigation_header_icon"
        android:nextFocusDown="@id/search"
        app:layout_constraintStart_toStartOf="@id/iv_navigation_header_icon"
        app:layout_constraintTop_toBottomOf="@id/view_provider_profile_divider">

        <ImageView
            android:id="@+id/iv_header_profile_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tv_header_profile_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelLargeEmphasized"
            android:textColor="?attr/colorOnSurface"
            tools:text="D" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_header_profile_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/fl_header_profile_avatar"
        app:layout_constraintTop_toTopOf="@id/fl_header_profile_avatar"
        tools:text="Profile Name" />

    <TextView
        android:id="@+id/tv_header_profile_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/main_menu_change_profile"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/fl_header_profile_avatar"
        app:layout_constraintTop_toBottomOf="@id/tv_header_profile_name" />

</com.tanasi.navigation.widget.NavigationSlideHeaderView>
