<?xml version="1.0" encoding="utf-8"?>
<!-- One swipe card: just the poster (title and facts are in the panel below the stack),
     the "not out yet" chip and the decision stamps. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.StreamFlix.Card.Elevated"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="24dp">

    <ImageView
        android:id="@+id/iv_swipe_poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tv_swipe_soon"
        style="@style/Widget.StreamFlix.Browse.ArtworkChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:backgroundTint="?attr/colorPrimaryContainer"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_swipe_stamp_add"
        style="@style/Widget.StreamFlix.Queue.Stamp"
        android:layout_gravity="top|start"
        android:rotation="-14"
        android:text="@string/queue_swipe_add"
        android:backgroundTint="?attr/colorPrimaryContainer"
        android:textColor="?attr/colorOnPrimaryContainer" />

    <TextView
        android:id="@+id/tv_swipe_stamp_skip"
        style="@style/Widget.StreamFlix.Queue.Stamp"
        android:layout_gravity="top|end"
        android:rotation="14"
        android:text="@string/queue_swipe_skip"
        android:backgroundTint="?attr/colorErrorContainer"
        android:textColor="?attr/colorOnErrorContainer" />

    <TextView
        android:id="@+id/tv_swipe_stamp_seen"
        style="@style/Widget.StreamFlix.Queue.Stamp"
        android:layout_gravity="center"
        android:text="@string/queue_swipe_seen"
        android:backgroundTint="?attr/colorTertiaryContainer"
        android:textColor="?attr/colorOnTertiaryContainer" />

</com.google.android.material.card.MaterialCardView>
