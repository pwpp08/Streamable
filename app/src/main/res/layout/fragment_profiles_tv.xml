<?xml version="1.0" encoding="utf-8"?>
<!-- TV profile picker: display headline, big focusable avatars, tonal D-pad buttons. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipChildren="false"
    android:padding="48dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceDisplaySmallEmphasized"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/profile_who_is_watching"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_profiles"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
        tools:itemCount="4"
        tools:listitem="@layout/item_profile_tv" />

    <TextView
        android:id="@+id/tv_profiles_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_no_profiles"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_profiles"
        app:layout_constraintEnd_toEndOf="@id/rv_profiles"
        app:layout_constraintStart_toStartOf="@id/rv_profiles"
        app:layout_constraintTop_toTopOf="@id/rv_profiles"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/ll_profile_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_profiles">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_profile"
            style="@style/Widget.StreamFlix.Button.Tv"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="@string/profile_add_btn"
            app:icon="@drawable/ic_sf_profiles" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_manage_profiles"
            style="@style/Widget.StreamFlix.Button.Tv"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:text="@string/profile_manage_btn" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
