<?xml version="1.0" encoding="utf-8"?>
<!-- Details section row (TV): emphasized header, D-pad row aligned with the 64dp text column. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_tv_show_recommendations_label"
        style="@style/Widget.StreamFlix.Details.SectionHeader.Tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:text="@string/details_more_like_this" />

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/hgv_tv_show_recommendations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="64dp"
        android:paddingTop="20dp"
        android:paddingEnd="64dp"
        android:paddingBottom="40dp"
        app:focusOutEnd="true"
        app:focusOutFront="true"
        tools:listitem="@layout/item_movie_tv" />

</LinearLayout>
