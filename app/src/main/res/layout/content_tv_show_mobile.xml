<?xml version="1.0" encoding="utf-8"?>
<!--
    Phone TV-show header. Sits over the fragment's backdrop (iv_tv_show_banner, 1:1): the spacer is
    0.7 of that height, so the poster rises out of the backdrop's fade into the surface.
    The Download tile queues a season (or every season) at 1080p.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp">

    <Space
        android:id="@+id/v_tv_show_hero_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,10:7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_tv_show_poster"
        android:layout_width="112dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:background="?attr/colorSurfaceContainerHigh"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_tv_show_hero_spacer"
        app:shapeAppearance="@style/ShapeAppearance.StreamFlix.Poster" />

    <LinearLayout
        android:id="@+id/ll_tv_show_heading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toBottomOf="@id/v_tv_show_hero_spacer"
        app:layout_goneMarginStart="20dp">

        <TextView
            android:id="@+id/tv_tv_show_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="?attr/textAppearanceHeadlineSmallEmphasized"
            android:textColor="?attr/colorOnSurface"
            tools:text="Title" />

        <!-- year · runtime · rating chip · quality -->
        <LinearLayout
            android:id="@+id/ll_tv_show_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:divider="@drawable/ud_meta_dot"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:showDividers="middle">

            <TextView
                android:id="@+id/tv_tv_show_released"
                style="@style/Widget.StreamFlix.Details.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="yyyy" />

            <TextView
                android:id="@+id/tv_tv_show_runtime"
                style="@style/Widget.StreamFlix.Details.Meta"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_height="wrap_content"
                tools:text="# h # min" />

            <LinearLayout
                android:id="@+id/ll_tv_show_rating"
                android:layout_width="wrap_content"
                android:minWidth="52dp"
                android:layout_height="24dp"
                android:background="@drawable/ud_rating_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/iv_tv_show_rating_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_star"
                    android:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tv_tv_show_rating"
                    android:layout_width="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textAppearance="?attr/textAppearanceLabelLargeEmphasized"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="#.#" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_tv_show_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ud_quality_pill"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textAllCaps="true"
                android:textAppearance="?attr/textAppearanceLabelMediumEmphasized"
                android:textColor="?attr/colorOnSurface"
                tools:text="HD" />
        </LinearLayout>
    </LinearLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iv_tv_show_poster,ll_tv_show_heading" />

    <HorizontalScrollView
        android:id="@+id/hsv_tv_show_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier1">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_tv_show_genres"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true" />
    </HorizontalScrollView>

    <!-- Watch S1 E2 + play options (trailer, more options). -->
    <com.google.android.material.button.MaterialSplitButton
        android:id="@+id/sb_tv_show_play"
        style="@style/Widget.StreamFlix.SplitButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsv_tv_show_genres"
>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tv_show_watch_now"
            style="@style/Widget.StreamFlix.SplitButton.Leading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/details_play"
            app:icon="@drawable/ic_ud_play" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tv_show_play_options"
            style="@style/Widget.StreamFlix.SplitButton.Trailing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/details_more_play_options"
            app:icon="@drawable/m3_split_button_chevron_avd" />
    </com.google.android.material.button.MaterialSplitButton>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pb_tv_show_progress_episode"
        style="@style/Widget.StreamFlix.Details.Progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:max="100"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/sb_tv_show_play"
        app:layout_constraintStart_toStartOf="@id/sb_tv_show_play"
        app:layout_constraintTop_toBottomOf="@id/sb_tv_show_play"
        tools:progress="60"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButtonGroup
        android:id="@+id/bg_tv_show_actions"
        style="@style/Widget.StreamFlix.Details.ActionGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pb_tv_show_progress_episode">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tv_show_favorite"
            style="@style/Widget.StreamFlix.Details.ActionTile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checkable="true"
            android:text="@string/details_action_favorite"
            app:icon="@drawable/ic_ud_favorite_toggle" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tv_show_download"
            style="@style/Widget.StreamFlix.Details.ActionTile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/downloads_show_button"
            app:icon="@drawable/ic_download" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tv_show_trailer"
            style="@style/Widget.StreamFlix.Details.ActionTile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/details_action_trailer"
            app:icon="@drawable/ic_ud_trailer" />

    </com.google.android.material.button.MaterialButtonGroup>

    <TextView
        android:id="@+id/tv_tv_show_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:lineSpacingMultiplier="1.1"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bg_tv_show_actions"
        tools:text="Overview" />

</androidx.constraintlayout.widget.ConstraintLayout>
