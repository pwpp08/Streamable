<?xml version="1.0" encoding="utf-8"?>
<!-- Swipe (phone): a whole page. Header with what each direction does, the poster stack, an info
     panel for the title on top (tap it or the poster for the details page), and the buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".fragments.queue.QueueSwipeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="@dimen/browse_gutter">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_swipe_back"
            style="@style/Widget.StreamFlix.Queue.HeaderIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/queue_close"
            app:icon="@drawable/ic_queue_close" />

        <TextView
            android:id="@+id/tv_swipe_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/queue_swipe_title"
            android:textAppearance="?attr/textAppearanceTitleMediumEmphasized"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tv_swipe_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:visibility="invisible"
            tools:text="3 added"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Left = skip, up = seen it, right = add. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/browse_gutter"
        android:paddingEnd="@dimen/browse_gutter">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/queue_swipe_hint_left"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/queue_swipe_hint_up"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/queue_swipe_hint_right"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fl_queue_swipe_stack"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <include
            android:id="@+id/card_queue_swipe_back"
            layout="@layout/item_queue_swipe_card" />

        <include
            android:id="@+id/card_queue_swipe_front"
            layout="@layout/item_queue_swipe_card" />

        <LinearLayout
            android:id="@+id/ll_queue_swipe_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.loadingindicator.LoadingIndicator
                style="@style/Widget.StreamFlix.LoadingIndicator.Contained"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/queue_swipe_loading"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_queue_swipe_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/queue_swipe_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The title the top card is about; separate from the poster so nothing covers the artwork. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_swipe_info"
        style="@style/Widget.StreamFlix.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/browse_gutter"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/browse_gutter"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_swipe_info_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleLargeEmphasized"
                android:textColor="?attr/colorOnSurface"
                tools:text="The Bear" />

            <TextView
                android:id="@+id/tv_swipe_info_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Series · 2022 · Drama, Comedy · ★ 8.6" />

            <TextView
                android:id="@+id/tv_swipe_info_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="A young chef from the fine dining world returns to Chicago to run his family's sandwich shop." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButtonGroup
        android:id="@+id/bg_queue_swipe_actions"
        style="@style/Widget.Material3Expressive.MaterialButtonGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/browse_gutter"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/browse_gutter"
        android:layout_marginBottom="12dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_queue_swipe_skip"
            style="@style/Widget.StreamFlix.Queue.SwipeAction.Outlined"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/queue_swipe_skip"
            app:icon="@drawable/ic_queue_close" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_queue_swipe_seen"
            style="@style/Widget.StreamFlix.Queue.SwipeAction.Tonal"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.2"
            android:text="@string/queue_swipe_seen"
            app:icon="@drawable/ic_watched" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_queue_swipe_add"
            style="@style/Widget.StreamFlix.Queue.SwipeAction.Filled"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/queue_swipe_add"
            app:icon="@drawable/ic_queue_add" />
    </com.google.android.material.button.MaterialButtonGroup>
</LinearLayout>
