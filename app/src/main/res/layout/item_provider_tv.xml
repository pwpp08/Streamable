<?xml version="1.0" encoding="utf-8"?>
<!-- TV provider card: logo tile, name, language and health dot. The focus ring is the card stroke
    (FocusScaleAnimator, set in ProviderViewHolder). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.StreamFlix.Card"
    android:layout_width="164dp"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:nextFocusUp="@id/ll_profile"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_provider_logo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?attr/colorSurfaceContainerHighest"
            android:duplicateParentState="true"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="?attr/shapeAppearanceCornerLarge"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/iv_provider_favorite"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="6dp"
            android:src="@drawable/ic_favorite_badge"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/iv_provider_logo"
            app:layout_constraintTop_toTopOf="@id/iv_provider_logo"
            tools:ignore="ContentDescription"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_provider_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_provider_logo"
            tools:text="Provider name" />

        <View
            android:id="@+id/v_provider_health"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_sf_health_dot"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tv_provider_language"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_provider_language"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_provider_language"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/v_provider_health"
            app:layout_constraintTop_toBottomOf="@id/tv_provider_name"
            app:layout_goneMarginStart="0dp"
            tools:text="Provider language" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
