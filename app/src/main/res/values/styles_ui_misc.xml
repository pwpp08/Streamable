<?xml version="1.0" encoding="utf-8"?>
<!--
    Styles for the settings, search and utility screens (profiles, providers, pairing, remote,
    downloads, health, home rows, update dialogs). Built on the tokens in docs/DESIGN_SYSTEM.md.
-->
<resources>

    <!-- ============================================================ settings: phone -->
    <!-- Theme.StreamFlix#preferenceTheme. Every preference type uses the expressive row layouts;
         the rounded group backgrounds come from SettingsGroupDecoration. -->
    <style name="PreferenceThemeOverlay.StreamFlix" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/Preference.StreamFlix</item>
        <item name="preferenceScreenStyle">@style/Preference.StreamFlix.Screen</item>
        <item name="preferenceCategoryStyle">@style/Preference.StreamFlix.Category</item>
        <item name="dialogPreferenceStyle">@style/Preference.StreamFlix.Dialog</item>
        <item name="editTextPreferenceStyle">@style/Preference.StreamFlix.EditText</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.StreamFlix.Switch</item>
        <item name="checkBoxPreferenceStyle">@style/Preference.StreamFlix.CheckBox</item>
        <item name="dropdownPreferenceStyle">@style/Preference.StreamFlix.DropDown</item>
    </style>

    <style name="Preference.StreamFlix" parent="Preference.Material">
        <item name="android:layout">@layout/preference_sf_row</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="Preference.StreamFlix.Screen" parent="Preference.PreferenceScreen.Material">
        <item name="android:layout">@layout/preference_sf_row</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="Preference.StreamFlix.Category" parent="Preference.Category.Material">
        <item name="android:layout">@layout/preference_sf_category</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="Preference.StreamFlix.Dialog" parent="Preference.DialogPreference.Material">
        <item name="android:layout">@layout/preference_sf_row</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="Preference.StreamFlix.EditText" parent="Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:layout">@layout/preference_sf_row</item>
        <item name="android:dialogLayout">@layout/preference_sf_dialog_edittext</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="Preference.StreamFlix.Switch" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/preference_sf_row</item>
        <item name="android:widgetLayout">@layout/preference_sf_widget_switch</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="Preference.StreamFlix.CheckBox" parent="Preference.CheckBoxPreference.Material">
        <item name="android:layout">@layout/preference_sf_row</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="Preference.StreamFlix.DropDown" parent="Preference.DropDown.Material">
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <!-- ============================================================ settings: TV -->
    <!-- Theme.StreamFlix.Tv#preferenceTheme: Leanback behaviour on the palette surface, with the
         tonal row layouts. -->
    <style name="PreferenceThemeOverlay.StreamFlix.Leanback" parent="PreferenceThemeOverlayLeanback">
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="preferenceStyle">@style/Preference.StreamFlix.Tv</item>
        <item name="preferenceScreenStyle">@style/Preference.StreamFlix.Tv.Screen</item>
        <item name="preferenceCategoryStyle">@style/Preference.StreamFlix.Tv.Category</item>
        <item name="dialogPreferenceStyle">@style/Preference.StreamFlix.Tv.Dialog</item>
        <item name="editTextPreferenceStyle">@style/Preference.StreamFlix.Tv.EditText</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.StreamFlix.Tv.Switch</item>
        <item name="checkBoxPreferenceStyle">@style/Preference.StreamFlix.Tv.CheckBox</item>
    </style>

    <style name="Preference.StreamFlix.Tv" parent="LeanbackPreference">
        <item name="android:layout">@layout/preference_sf_row_tv</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.StreamFlix.Tv.Screen" parent="LeanbackPreference.PreferenceScreen">
        <item name="android:layout">@layout/preference_sf_row_tv</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.StreamFlix.Tv.Category" parent="LeanbackPreference.Category">
        <item name="android:layout">@layout/preference_sf_category_tv</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.StreamFlix.Tv.Dialog" parent="LeanbackPreference.DialogPreference">
        <item name="android:layout">@layout/preference_sf_row_tv</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.StreamFlix.Tv.EditText" parent="LeanbackPreference.DialogPreference.EditTextPreference">
        <item name="android:layout">@layout/preference_sf_row_tv</item>
        <item name="android:dialogLayout">@layout/preference_sf_dialog_edittext</item>
        <item name="android:positiveButtonText">@android:string/ok</item>
        <item name="android:negativeButtonText">@android:string/cancel</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.StreamFlix.Tv.Switch" parent="LeanbackPreference.SwitchPreferenceCompat">
        <item name="android:layout">@layout/preference_sf_row_tv</item>
        <item name="android:widgetLayout">@layout/preference_sf_widget_switch</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.StreamFlix.Tv.CheckBox" parent="LeanbackPreference.CheckBoxPreference">
        <item name="android:layout">@layout/preference_sf_row_tv</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="TextAppearance.StreamFlix.Settings.TvTitle" parent="TextAppearance.StreamFlix.TitleMedium">
        <item name="android:textSize">18sp</item>
    </style>
    <style name="TextAppearance.StreamFlix.Settings.TvSummary" parent="TextAppearance.StreamFlix.BodyMedium">
        <item name="android:textSize">15sp</item>
    </style>
    <style name="TextAppearance.StreamFlix.Settings.TvScreenTitle" parent="TextAppearance.StreamFlix.HeadlineSmall.Emphasized">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

</resources>
