<?xml version="1.0" encoding="utf-8"?>
<!--
    StreamFlix Material 3 Expressive theme system (MDC 1.14). See docs/DESIGN_SYSTEM.md.

    Theme.StreamFlix            phone base   (Theme.Material3Expressive.Dark.NoActionBar)
    Theme.StreamFlix.Tv         TV base      (Theme.StreamFlix + the MDC ".FocusRings" items + Leanback attrs)
    Theme.StreamFlix[.Tv].<P>   palettes     (values/themes_palettes.xml, generated from HCT seeds)

    Palette colour roles live ONLY in themes_palettes.xml. Everything else (type, shape, motion,
    component defaults) lives here so every palette and both form factors share it.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================================================================== phone base -->
    <style name="Theme.StreamFlix" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <!-- Window / edge-to-edge. System bars are transparent; ThemeManager.applySystemBars()
             sets icon contrast from colorSurface. -->
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>

        <!-- App attrs (kept for existing layouts). All follow the palette's surface. -->
        <item name="app_background_color">?attr/colorSurface</item>
        <item name="home_gradient_drawable">@drawable/bg_home_gradient</item>
        <item name="movie_banner_gradient_drawable">@drawable/bg_banner_gradient</item>
        <item name="tv_show_banner_gradient_drawable">@drawable/bg_banner_gradient</item>
        <item name="category_swiper_gradient_drawable">@drawable/fg_category_swiper</item>

        <!-- Typography: Google Sans Flex everywhere. android:fontFamily at theme level also reaches
             framework TextViews/Buttons (the main activities are FragmentActivity, no AppCompat
             view substitution). -->
        <item name="android:fontFamily">@font/sf_sans</item>
        <item name="fontFamily">@font/sf_sans</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.StreamFlix.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.StreamFlix.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.StreamFlix.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.StreamFlix.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.StreamFlix.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.StreamFlix.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.StreamFlix.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.StreamFlix.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.StreamFlix.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.StreamFlix.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.StreamFlix.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.StreamFlix.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.StreamFlix.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.StreamFlix.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.StreamFlix.LabelSmall</item>
        <item name="textAppearanceDisplayLargeEmphasized">@style/TextAppearance.StreamFlix.DisplayLarge.Emphasized</item>
        <item name="textAppearanceDisplayMediumEmphasized">@style/TextAppearance.StreamFlix.DisplayMedium.Emphasized</item>
        <item name="textAppearanceDisplaySmallEmphasized">@style/TextAppearance.StreamFlix.DisplaySmall.Emphasized</item>
        <item name="textAppearanceHeadlineLargeEmphasized">@style/TextAppearance.StreamFlix.HeadlineLarge.Emphasized</item>
        <item name="textAppearanceHeadlineMediumEmphasized">@style/TextAppearance.StreamFlix.HeadlineMedium.Emphasized</item>
        <item name="textAppearanceHeadlineSmallEmphasized">@style/TextAppearance.StreamFlix.HeadlineSmall.Emphasized</item>
        <item name="textAppearanceTitleLargeEmphasized">@style/TextAppearance.StreamFlix.TitleLarge.Emphasized</item>
        <item name="textAppearanceTitleMediumEmphasized">@style/TextAppearance.StreamFlix.TitleMedium.Emphasized</item>
        <item name="textAppearanceTitleSmallEmphasized">@style/TextAppearance.StreamFlix.TitleSmall.Emphasized</item>
        <item name="textAppearanceBodyLargeEmphasized">@style/TextAppearance.StreamFlix.BodyLarge.Emphasized</item>
        <item name="textAppearanceBodyMediumEmphasized">@style/TextAppearance.StreamFlix.BodyMedium.Emphasized</item>
        <item name="textAppearanceBodySmallEmphasized">@style/TextAppearance.StreamFlix.BodySmall.Emphasized</item>
        <item name="textAppearanceLabelLargeEmphasized">@style/TextAppearance.StreamFlix.LabelLarge.Emphasized</item>
        <item name="textAppearanceLabelMediumEmphasized">@style/TextAppearance.StreamFlix.LabelMedium.Emphasized</item>
        <item name="textAppearanceLabelSmallEmphasized">@style/TextAppearance.StreamFlix.LabelSmall.Emphasized</item>
        <!-- Legacy MDC2 names still used by existing layouts, mapped onto the M3 scale. -->
        <item name="textAppearanceHeadline3">@style/TextAppearance.StreamFlix.DisplaySmall</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.StreamFlix.HeadlineMedium</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.StreamFlix.HeadlineSmall</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.StreamFlix.TitleLarge</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.StreamFlix.TitleMedium</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.StreamFlix.TitleSmall</item>
        <item name="textAppearanceBody1">@style/TextAppearance.StreamFlix.BodyLarge</item>
        <item name="textAppearanceBody2">@style/TextAppearance.StreamFlix.BodyMedium</item>
        <item name="textAppearanceCaption">@style/TextAppearance.StreamFlix.BodySmall</item>
        <item name="textAppearanceButton">@style/TextAppearance.StreamFlix.LabelLarge</item>
        <item name="textAppearanceOverline">@style/TextAppearance.StreamFlix.LabelSmall</item>

        <!-- Shape: M3 Expressive corner scale (MDC 1.14 shapeCornerSize* tokens). -->
        <item name="shapeCornerSizeExtraSmall">4dp</item>
        <item name="shapeCornerSizeSmall">8dp</item>
        <item name="shapeCornerSizeMedium">12dp</item>
        <item name="shapeCornerSizeLarge">16dp</item>
        <item name="shapeCornerSizeLargeIncreased">20dp</item>
        <item name="shapeCornerSizeExtraLarge">28dp</item>
        <item name="shapeCornerSizeExtraLargeIncreased">32dp</item>
        <item name="shapeCornerSizeExtraExtraLarge">48dp</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Material3.Corner.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Material3.Corner.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Material3.Corner.Large</item>

        <!-- Motion: MDC 1.14 spring tokens, tuned (see values/motion.xml). Read by ui/motion/Springs.kt. -->
        <item name="motionSpringFastSpatial">@style/Motion.StreamFlix.Spring.Fast.Spatial</item>
        <item name="motionSpringDefaultSpatial">@style/Motion.StreamFlix.Spring.Default.Spatial</item>
        <item name="motionSpringSlowSpatial">@style/Motion.StreamFlix.Spring.Slow.Spatial</item>
        <item name="motionSpringFastEffects">@style/Motion.StreamFlix.Spring.Fast.Effects</item>
        <item name="motionSpringDefaultEffects">@style/Motion.StreamFlix.Spring.Default.Effects</item>
        <item name="motionSpringSlowEffects">@style/Motion.StreamFlix.Spring.Slow.Effects</item>

        <!-- Component defaults (values/styles_components.xml). -->
        <item name="materialButtonStyle">@style/Widget.StreamFlix.Button</item>
        <item name="materialButtonTonalStyle">@style/Widget.StreamFlix.Button.Tonal</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.StreamFlix.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.StreamFlix.Card</item>
        <item name="materialCardViewFilledStyle">@style/Widget.StreamFlix.Card</item>
        <item name="materialCardViewElevatedStyle">@style/Widget.StreamFlix.Card.Elevated</item>
        <item name="bottomNavigationStyle">@style/Widget.StreamFlix.BottomNavigation</item>
        <item name="navigationRailStyle">@style/Widget.StreamFlix.NavigationRail</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.StreamFlix.CircularProgressIndicator</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.StreamFlix.LinearProgressIndicator</item>
        <item name="loadingIndicatorStyle">@style/Widget.StreamFlix.LoadingIndicator</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.StreamFlix.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Material3Expressive.Dialog.Alert</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.StreamFlix.BottomSheetDialog</item>
        <item name="chipStyle">@style/Widget.StreamFlix.Chip</item>
        <item name="sliderStyle">@style/Widget.StreamFlix.Slider</item>
        <item name="materialSearchBarStyle">@style/Widget.StreamFlix.SearchBar</item>
        <item name="materialSearchViewStyle">@style/Widget.Material3Expressive.SearchView</item>
        <item name="snackbarStyle">@style/Widget.Material3.Snackbar</item>
        <!-- Expressive grouped settings rows (values/styles_ui_misc.xml). TV overrides it. -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.StreamFlix</item>
    </style>

    <!-- Light phone base. Generated Light palettes hang off it; unused until screens are light-safe. -->
    <style name="Theme.StreamFlix.Light" parent="Theme.Material3Expressive.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="app_background_color">?attr/colorSurface</item>
        <item name="home_gradient_drawable">@drawable/bg_home_gradient</item>
        <item name="movie_banner_gradient_drawable">@drawable/bg_banner_gradient</item>
        <item name="tv_show_banner_gradient_drawable">@drawable/bg_banner_gradient</item>
        <item name="category_swiper_gradient_drawable">@drawable/fg_category_swiper</item>
        <item name="android:fontFamily">@font/sf_sans</item>
        <item name="fontFamily">@font/sf_sans</item>
    </style>

    <!-- ===================================================================== TV base -->
    <!--
        Everything from Theme.StreamFlix plus the items MDC 1.14 defines in
        Theme.Material3Expressive.Dark.NoActionBar.FocusRings (copied verbatim, so TV gets the
        M3 focus-ring drawables for D-pad), plus the Leanback attributes our Leanback widgets and
        LeanbackPreferenceFragmentCompat read (defaultBrandColor, preferenceTheme, ...).
        Dark only.
    -->
    <style name="Theme.StreamFlix.Tv" parent="Theme.StreamFlix">
        <!-- = Theme.Material3Expressive.Dark.NoActionBar.FocusRings -->
        <item name="focusRingsEnabled">true</item>
        <item name="android:selectableItemBackground">@drawable/m3_focus_ring_item_background</item>
        <item name="selectableItemBackground">@drawable/m3_focus_ring_item_background</item>
        <item name="android:selectableItemBackgroundBorderless">@drawable/m3_focus_ring_item_background_borderless</item>
        <item name="selectableItemBackgroundBorderless">@drawable/m3_focus_ring_item_background_borderless</item>
        <item name="android:actionBarItemBackground">@drawable/m3_focus_ring_action_bar_item_background</item>
        <item name="actionBarItemBackground">@drawable/m3_focus_ring_action_bar_item_background</item>
        <item name="controlBackground">@drawable/m3_focus_ring_control_background</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/m3_focus_ring_list_selector_background</item>
        <item name="listChoiceBackgroundIndicator">@drawable/m3_focus_ring_list_selector_background</item>
        <item name="toolbarNavigationButtonBackground">@drawable/m3_focus_ring_control_background</item>
        <item name="materialToolbarSelectableItemBackground">@drawable/m3_focus_ring_toolbar_selectable_item_background</item>
        <item name="materialToolbarSelectableItemBackgroundBorderless">@drawable/m3_focus_ring_toolbar_selectable_item_background_borderless</item>
        <item name="materialToolbarActionBarItemBackground">@drawable/m3_focus_ring_toolbar_action_bar_item_background</item>
        <item name="android:buttonStyle">@style/Widget.Material.Button.FocusRing</item>
        <item name="buttonStyle">@style/Widget.Material.Button.FocusRing</item>
        <item name="android:buttonStyleSmall">@style/Widget.Material.Button.Small.FocusRing</item>
        <item name="buttonStyleSmall">@style/Widget.Material.Button.Small.FocusRing</item>
        <item name="android:borderlessButtonStyle">@style/Widget.Material.Button.Borderless.FocusRing</item>
        <item name="android:imageButtonStyle">@style/Widget.Material.ImageButton.FocusRing</item>
        <item name="imageButtonStyle">@style/Widget.Material.ImageButton.FocusRing</item>
        <item name="android:checkboxStyle">@style/Widget.Material.CompoundButton.CheckBox.FocusRing</item>
        <item name="android:radioButtonStyle">@style/Widget.Material.CompoundButton.RadioButton.FocusRing</item>
        <!-- Focus ring colour follows the palette. -->
        <item name="focusRingsOuterStrokeColor">?attr/colorPrimary</item>

        <!-- Leanback (previously inherited from Theme.Leanback). -->
        <item name="android:windowOverscan">true</item>
        <item name="defaultBrandColor">?attr/colorSurfaceContainer</item>
        <item name="defaultBrandColorDark">?attr/colorSurfaceContainerLow</item>
        <item name="defaultSearchColor">?attr/colorSurfaceContainerHigh</item>
        <item name="defaultSearchBrightColor">?attr/colorSurfaceContainerHighest</item>
        <item name="defaultSearchIconColor">?attr/colorOnSurface</item>
        <item name="playbackProgressPrimaryColor">?attr/colorPrimary</item>
        <item name="playbackControlsIconHighlightColor">?attr/colorPrimary</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.StreamFlix.Leanback</item>

        <!-- TV component tweaks: chunkier slider for 10-foot use. -->
        <item name="sliderStyle">@style/Widget.StreamFlix.Slider.Tv</item>
    </style>

    <!-- PreferenceThemeOverlay.StreamFlix(.Leanback): see values/styles_ui_misc.xml. -->

    <!-- ===================================================================== aliases -->
    <!-- Manifest defaults; activities replace them via ThemeManager in onCreate. -->
    <style name="AppTheme.Mobile" parent="Theme.StreamFlix.Crimson" />
    <style name="AppTheme.Tv" parent="Theme.StreamFlix.Tv.Crimson" />

    <!-- Launch window (logo on the brand surface) before the activity theme is applied. -->
    <style name="AppTheme.SplashScreen" parent="Theme.StreamFlix.Crimson">
        <item name="android:windowBackground">@drawable/bg_splash_screen</item>
    </style>

    <!--
        Former local MaterialComponents wrappers. The activity themes are Material3 now, so these
        are EMPTY overlays: wrapping a context with them keeps the active palette. Kept so existing
        ContextThemeWrapper / android:theme references stay valid; new code should not use them.
    -->
    <style name="Theme.StreamFlix.Sync" parent="" />
    <style name="Theme.StreamFlix.Health" parent="" />
    <style name="Theme.StreamFlix.PlayerOverlay" parent="" />

</resources>
