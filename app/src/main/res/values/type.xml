<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        M3 type scale + MDC 1.14 emphasized scale, re-pointed at @font/sf_sans (Google Sans Flex).
        Sizes / line heights / tracking come from the MDC parents; only family and weight change.
        Emphasized = one weight step up (400 -> 500, 500 -> 600).
        Use through theme attrs, e.g. android:textAppearance="?attr/textAppearanceTitleLargeEmphasized".
    -->
    <style name="TextAppearance.StreamFlix.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/sf_sans</item>
        <item name="android:fontFamily">@font/sf_sans</item>
        <item name="android:textFontWeight" tools:targetApi="p">400</item>
    </style>
    <style name="TextAppearance.StreamFlix.DisplayLarge.Emphasized" parent="TextAppearance.Material3.DisplayLarge.Emphasized">
        <item name="fontFamily">@font/sf_sans</item>
