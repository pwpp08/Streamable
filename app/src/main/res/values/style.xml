<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Legacy framework-Button styles still used by older layouts; colours follow the palette.
         New screens should use MaterialButton with ?attr/materialButtonStyle instead. -->
    <style name="AppTheme.Widget.Tv.Button" parent="">
        <item name="android:background">@drawable/bg_button_tv</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/color_button_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button" parent="">
        <item name="android:background">@drawable/bg_button_mobile</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button.Secondary" parent="AppTheme.Widget.Mobile.Button">
        <item name="android:background">@drawable/bg_button_secondary_mobile</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

</resources>
