<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="health_status_ok">#4CAF50</color>
    <color name="health_status_fail">#F44336</color>
    <color name="health_status_unknown">#9E9E9E</color>

    <dimen name="health_padding_horizontal">16dp</dimen>
    <dimen name="health_padding_vertical">16dp</dimen>
    <dimen name="health_padding_horizontal_tv">48dp</dimen>
    <dimen name="health_padding_vertical_tv">27dp</dimen>

    <!-- Applied on top of the activity theme for the source health screen, so Material
         Components widgets work on both the AppCompat (phone) and Leanback (TV) themes while
         app attributes such as app_background_color still resolve. -->
    <style name="Theme.StreamFlix.Health" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorPrimaryVariant">#BDBDBD</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">#FFFFFF</item>
        <item name="colorSecondaryVariant">#BDBDBD</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSurface">#242424</item>
        <item name="colorOnSurface">#FFFFFF</item>
    </style>

</resources>
