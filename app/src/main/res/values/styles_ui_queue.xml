<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Emoji reaction in a connected toggle group. -->
    <style name="Widget.StreamFlix.Queue.ReactionButton" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:checkable">true</item>
        <item name="android:textSize">22sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- One of the five ratings in the "How was it?" popup: emoji over a short label. -->
    <style name="Widget.StreamFlix.Queue.RatingChoice" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:textSize">11sp</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:maxLines">3</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
    </style>

    <!-- Full-width, start-aligned action row in the Queue sheet. -->
    <style name="Widget.StreamFlix.Queue.SheetAction" parent="Widget.Material3Expressive.Button.TextButton">
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="iconPadding">20dp</item>
        <item name="iconGravity">start</item>
    </style>

    <!-- Section switch in a connected toggle group: the checked segment fills with primary. -->
    <style name="Widget.StreamFlix.Queue.SectionButton" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:checkable">true</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <!-- Icon action in the Queue header row. -->
    <style name="Widget.StreamFlix.Queue.HeaderIcon" parent="Widget.Material3Expressive.Button.IconButton.Standard">
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="iconSize">22dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <!-- Compact filter chip (kind and rating filters). -->
    <style name="Widget.StreamFlix.Queue.FilterChip" parent="Widget.StreamFlix.Chip">
        <item name="chipMinHeight">32dp</item>
        <item name="android:textSize">13sp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- Swipe page actions: one line, icon on the left, so "Seen it" never wraps. -->
    <style name="Widget.StreamFlix.Queue.SwipeAction.Base" parent="">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
    </style>
    <style name="Widget.StreamFlix.Queue.SwipeAction.Outlined" parent="Widget.StreamFlix.Button.Outlined">
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
    </style>
    <style name="Widget.StreamFlix.Queue.SwipeAction.Tonal" parent="Widget.StreamFlix.Button.Tonal">
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
    </style>
    <style name="Widget.StreamFlix.Queue.SwipeAction.Filled" parent="Widget.StreamFlix.Button">
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- Spin / Swipe: big tonal tools under the section switch. -->
    <style name="Widget.StreamFlix.Queue.ToolButton" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- ADD / SKIP / SEEN label that fades in while a swipe card is dragged. -->
    <style name="Widget.StreamFlix.Queue.Stamp" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">24dp</item>
        <item name="android:alpha">0</item>
        <item name="android:background">@drawable/bg_queue_stamp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleLargeEmphasized</item>
    </style>


    <!-- Full-screen dialog that keeps the app theme (only window attributes change). -->
    <style name="ThemeOverlay.StreamFlix.FullscreenDialog" parent="">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">?attr/app_background_color</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
