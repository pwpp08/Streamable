<?xml version="1.0" encoding="utf-8"?>
<!-- Icon and label colour: on the primary pill when focused, on the tonal pill when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="?attr/colorOnPrimary" />
    <item android:state_selected="true" android:color="?attr/colorOnSecondaryContainer" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
